{
  "id": "T-KNIFE-001-QA",
  "title": "Runtime QA for KNIFE_001",
  "goal": "Prove KNIFE_001 is visible, testable, error-free, and within the configured runtime performance budget.",
  "kind": "qa",
  "dependencies": ["T-KNIFE-001-UNITY"],
  "maxAttempts": 3,
  "acceptanceCriteria": [
    {
      "id": "A01",
      "description": "Unity PlayMode enters successfully and the validation scene is live.",
      "requiredEvidence": ["runtime-observation"]
    },
    {
      "id": "A02",
      "description": "No relevant Console errors are present.",
      "requiredEvidence": ["log"]
    },
    {
      "id": "A03",
      "description": "KNIFE_001 is visibly present in the validation scene.",
      "requiredEvidence": ["screenshot", "runtime-observation"]
    },
    {
      "id": "A04",
      "description": "Automated validation tests pass.",
      "requiredEvidence": ["test"]
    },
    {
      "id": "A05",
      "description": "The configured profiling check completes.",
      "requiredEvidence": ["profiler"]
    }
  ],
  "execution": {
    "steps": [
      {
        "id": "playmode",
        "adapter": "unity",
        "action": "playmode",
        "criterionId": "A01",
        "evidenceType": "runtime-observation"
      },
      {
        "id": "console",
        "adapter": "unity",
        "action": "console",
        "criterionId": "A02",
        "evidenceType": "log"
      },
      {
        "id": "screenshot",
        "adapter": "unity",
        "action": "screenshot",
        "criterionId": "A03",
        "evidenceType": "screenshot",
        "input": { "assetId": "KNIFE_001" }
      },
      {
        "id": "scene-inspect",
        "adapter": "unity",
        "action": "inspect_scene",
        "criterionId": "A03",
        "evidenceType": "runtime-observation",
        "input": { "assetId": "KNIFE_001" }
      },
      {
        "id": "tests",
        "adapter": "unity",
        "action": "tests",
        "criterionId": "A04",
        "evidenceType": "test"
      },
      {
        "id": "profile",
        "adapter": "unity",
        "action": "profile",
        "criterionId": "A05",
        "evidenceType": "profiler"
      }
    ]
  }
}
