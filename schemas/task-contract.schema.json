{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-3d-game-harness.local/schemas/task-contract.schema.json",
  "title": "AI 3D Game Harness Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "goal",
    "kind",
    "dependencies",
    "acceptanceCriteria",
    "maxAttempts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "blender",
        "unity",
        "integration",
        "gameplay",
        "qa",
        "build",
        "generic"
      ]
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "requiredEvidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "requiredEvidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "file",
                "log",
                "screenshot",
                "test",
                "profiler",
                "asset-report",
                "runtime-observation"
              ]
            }
          }
        }
      }
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  }
}
